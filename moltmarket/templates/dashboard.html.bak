<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MOLTmarket Live Validation Dashboard</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <link rel="stylesheet" href="{{ url_for('static', filename='dashboard.css') }}">
</head>
<body>
    <div class="dashboard-container">
        <!-- Header -->
        <div class="dashboard-header">
            <div class="header-title">
                <h1>MOLTmarket Live Validation</h1>
                <span class="header-subtitle">Paper • Shadow • Backtest</span>
            </div>
            <div class="header-controls">
                <div class="time-range">
                    <button class="range-btn active" data-range="1h">1h</button>
                    <button class="range-btn" data-range="4h">4h</button>
                    <button class="range-btn" data-range="1d">1d</button>
                </div>
                <!-- PHASE 29: New Run Button -->
                <button id="newRunButton" class="btn-new-run" title="Start new experiment run (preserves all historical data)">[ New Run ]</button>
                <div class="status-indicator">
                    <span class="status-dot"></span>
                    <span id="status-text">Initializing...</span>
                </div>
            </div>
        </div>
        
        <!-- PHASE 29: Run ID Display -->
        <div class="run-id-display">
            <span>Run:</span>
            <span id="run-id" class="run-id-value">—</span>
        </div>

        <!-- PHASE 32.2 PART 1: Active Strategy Label -->
        <div class="active-strategy-label">
            <span class="label-text">ACTIVE STRATEGY:</span>
            <span id="active-strategy" class="strategy-value">baseline • Gen 0</span>
        </div>

        <!-- KPI Cards -->
        <div class="kpi-grid">
            <div class="kpi-card">
                <div class="kpi-label">Paper Rolling Value</div>
                <div class="kpi-value" id="kpi-paper">$10,000.00</div>
                <div class="kpi-change positive">↑ 0.00%</div>
            </div>

            <div class="kpi-card">
                <div class="kpi-label">Shadow Rolling Value</div>
                <div class="kpi-value" id="kpi-shadow">$10,000.00</div>
                <div class="kpi-change negative">↓ 0.00%</div>
            </div>

            <div class="kpi-card">
                <div class="kpi-label">Paper vs Shadow Delta</div>
                <div class="kpi-value" id="kpi-delta">0.00%</div>
                <div class="kpi-subtext">Execution impact</div>
            </div>

            <div class="kpi-card">
                <div class="kpi-label">Backtest Edge</div>
                <div class="kpi-value" id="kpi-edge">0.00<span class="bps-suffix">bps</span></div>
                <div class="kpi-subtext">Historical reference</div>
            </div>

            <div class="kpi-card">
                <div class="kpi-label">Total Trades</div>
                <div class="kpi-value" id="kpi-trades">0</div>
                <div class="kpi-subtext">Across all layers</div>
            </div>

            <div class="kpi-card">
                <div class="kpi-label">Rolling Win Rate</div>
                <div class="kpi-value" id="kpi-winrate">0.0<span class="pct-suffix">%</span></div>
                <div class="kpi-subtext">Last 20 trades</div>
            </div>

            <div class="kpi-card">
                <div class="kpi-label">Avg PnL / Trade</div>
                <div class="kpi-value" id="kpi-avgpnl">$0.00<span class="bps-suffix">bps</span></div>
                <div class="kpi-subtext">All trades</div>
            </div>

            <div class="kpi-card">
                <div class="kpi-label">Current Signal / Asset</div>
                <div class="kpi-value signal-display">
                    <span id="signal-name">—</span> / <span id="asset-name">—</span>
                </div>
                <div class="kpi-subtext" id="regime-label">Regime: —</div>
            </div>

            <!-- PHASE 28: Execution Diagnostics -->
            <div class="kpi-card">
                <div class="kpi-label">Avg Entry Slippage</div>
                <div class="kpi-value" id="kpi-entry-slippage">0.00<span class="bps-suffix">bps</span></div>
                <div class="kpi-subtext">Expected vs Shadow</div>
            </div>

            <div class="kpi-card">
                <div class="kpi-label">Avg Exit Slippage</div>
                <div class="kpi-value" id="kpi-exit-slippage">0.00<span class="bps-suffix">bps</span></div>
                <div class="kpi-subtext">Expected vs Shadow</div>
            </div>

            <div class="kpi-card">
                <div class="kpi-label">Trade Sign Flips</div>
                <div class="kpi-value" id="kpi-sign-flips">0<span class="pct-suffix">%</span></div>
                <div class="kpi-subtext" id="flip-count">Winners → Losers</div>
            </div>
        </div>


        <!-- Main Chart Section -->
        <div class="chart-section">
            <div class="chart-header">
                <h2>Equity Curves: Paper vs Shadow vs Backtest</h2>
                <div class="chart-toggles">
                    <label class="toggle-label">
                        <input type="checkbox" id="toggle-paper" checked>
                        <span class="toggle-indicator paper-color"></span>
                        Paper
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" id="toggle-shadow" checked>
                        <span class="toggle-indicator shadow-color"></span>
                        Shadow
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" id="toggle-backtest" checked>
                        <span class="toggle-indicator backtest-color"></span>
                        Backtest
                    </label>
                </div>
            </div>
            <div class="chart-container">
                <canvas id="equityChart"></canvas>
            </div>
        </div>

        <!-- Secondary Panels -->
        <div class="panels-grid">
            <div class="panel">
                <h3>Execution Degradation</h3>
                <div class="panel-content">
                    <div class="metric-row">
                        <span>Paper Slippage</span>
                        <span class="metric-value">0-2 bps</span>
                    </div>
                    <div class="metric-row">
                        <span>Shadow Slippage</span>
                        <span class="metric-value">2-5 bps</span>
                    </div>
                    <div class="metric-row">
                        <span>Round-Trip Cost</span>
                        <span class="metric-value">10 bps</span>
                    </div>
                </div>
            </div>

            <div class="panel">
                <h3>Fill Rates</h3>
                <div class="panel-content">
                    <div class="metric-row">
                        <span>Paper Fill %</span>
                        <span class="metric-value">100.0%</span>
                    </div>
                    <div class="metric-row">
                        <span>Shadow Fill %</span>
                        <span class="metric-value">98.5%</span>
                    </div>
                    <div class="metric-row">
                        <span>Partial Fills</span>
                        <span class="metric-value">0</span>
                    </div>
                </div>
            </div>

            <div class="panel">
                <h3>Rolling Edge (20-trade)</h3>
                <div class="panel-content">
                    <div class="metric-row">
                        <span>Current Edge</span>
                        <span class="metric-value" id="edge-20">0.00 bps</span>
                    </div>
                    <div class="metric-row">
                        <span>Avg Win</span>
                        <span class="metric-value" id="avg-win">$0.00</span>
                    </div>
                    <div class="metric-row">
                        <span>Avg Loss</span>
                        <span class="metric-value" id="avg-loss">$0.00</span>
                    </div>
                </div>
            </div>

            <div class="panel">
                <h3>Rolling Edge (50-trade)</h3>
                <div class="panel-content">
                    <div class="metric-row">
                        <span>Current Edge</span>
                        <span class="metric-value" id="edge-50">0.00 bps</span>
                    </div>
                    <div class="metric-row">
                        <span>Drawdown</span>
                        <span class="metric-value" id="drawdown">0.00%</span>
                    </div>
                    <div class="metric-row">
                        <span>Recovery</span>
                        <span class="metric-value" id="recovery">0 trades</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Breakdown Tables -->
        <div class="breakdowns-section">
            <h2>Trade Breakdowns</h2>
            <div class="breakdowns-grid">
                <div class="breakdown-table">
                    <h3>By Asset</h3>
                    <table>
                        <thead>
                            <tr><th>Asset</th><th>Trades</th><th>PnL</th><th>Win %</th></tr>
                        </thead>
                        <tbody id="breakdown-asset"></tbody>
                    </table>
                </div>

                <div class="breakdown-table">
                    <h3>By Signal</h3>
                    <table>
                        <thead>
                            <tr><th>Signal</th><th>Trades</th><th>PnL</th><th>Win %</th></tr>
                        </thead>
                        <tbody id="breakdown-signal"></tbody>
                    </table>
                </div>

                <div class="breakdown-table">
                    <h3>By Regime</h3>
                    <table>
                        <thead>
                            <tr><th>Regime</th><th>Trades</th><th>PnL</th><th>Win %</th></tr>
                        </thead>
                        <tbody id="breakdown-regime"></tbody>
                    </table>
                </div>

                <div class="breakdown-table">
                    <h3>By Direction</h3>
                    <table>
                        <thead>
                            <tr><th>Direction</th><th>Trades</th><th>PnL</th><th>Win %</th></tr>
                        </thead>
                        <tbody id="breakdown-direction"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- PHASE 31: Variant Nursery Panel -->
        <div class="nursery-panel">
            <h2>Variant Nursery (Concurrent Evolution)</h2>
            <div class="nursery-controls">
                <button id="spawnBabiesBtn" class="btn-spawn-babies">[ Spawn Babies (10) ]</button>
                <span class="nursery-info">
                    <span>Status: <span id="nursery-status">idle</span></span>
                    <span>Babies: <span id="nursery-count">0</span>/10</span>
                    <span>Top Candidate: <span id="top-candidate">—</span></span>
                </span>
            </div>
            <div class="nursery-table-wrapper">
                <table class="nursery-leaderboard">
                    <thead>
                        <tr>
                            <th>Variant</th>
                            <th>Mutation</th>
                            <th>Trades</th>
                            <th>Shadow PnL</th>
                            <th>Flip Rate</th>
                            <th>Degradation</th>
                            <th>Score</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="nursery-body">
                        <!-- Populated by JS -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- PHASE 32.2 PART 4: Reset Controls -->
        <div class="strategy-controls">
            <button id="resetBaselineBtn" class="btn-reset-baseline" title="Reset to baseline strategy (does NOT reset equity/P&L)">[ Reset to Baseline Strategy ]</button>
            <button id="resetCapitalBtn" class="btn-reset-capital" title="Reset arena capital to $10,000 (does NOT change strategy)">[ Reset Arena Capital ]</button>
            <button id="saveDnaBtn" class="btn-save-dna" title="Save current bot DNA to file">[ SAVE DNA ]</button>
            <button id="evaluateBotBtn" class="btn-evaluate" title="Evaluate bot against deployment rules">[ EVALUATE BOT ]</button>
        </div>
        
        <!-- DNA Panel -->
        <div id="dnaPanel" class="dna-panel hidden">
            <h3>🧬 Arena DNA</h3>
            <div id="dnaContent"></div>
        </div>
        
        <!-- Evaluation Panel -->
        <div id="evalPanel" class="eval-panel hidden">
            <h3>✓ Evaluation Result</h3>
            <div id="evalContent"></div>
        </div>

                <!-- PHASE 4: Mutation Ready Banner -->
        <div id="mutationBanner" class="mutation-banner" style="display: none; background: #1b5e20; border: 2px solid #4CAF50; border-radius: 6px; padding: 16px; margin-bottom: 15px; color: #fff;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <span style="font-size: 20px;">🧬</span>
                <div style="flex: 1;">
                    <strong>Mutation Ready</strong><br>
                    <span style="font-size: 12px; color: #ccc;">Approved proposal is queued. → Click "Spawn Babies" to apply this mutation.</span>
                </div>
            </div>
        </div>

<!-- Rocky — Operator Notes Panel -->
        <div class="panel" style="background: #1a1a2e; border: 1px solid #0f3460; margin-top: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                <h3 style="margin: 0; color: #00d4ff;">⚙️ Rocky — Operator Notes</h3>
                <button id="rockyInsightBtn" class="btn-primary" style="padding: 8px 16px; font-size: 12px;">
                    [Generate Insight]
                </button>
            </div>
            <div id="rockyContent" style="background: #0f1419; padding: 12px; border-radius: 4px; min-height: 200px; max-height: 400px; overflow-y: auto; font-family: monospace; font-size: 11px; color: #aaa; line-height: 1.5;">
                <div style="color: #666;">Waiting for insight...</div>
            </div>
            <div id="rockyDecisionButtons" style="margin-top: 12px; display: none; gap: 10px;">
                <button id="rockyApproveBtn" class="btn-primary" style="padding: 10px 20px; font-size: 12px; background: #4CAF50; flex: 1;">
                    [ APPROVE ]
                </button>
                <button id="rockyRejectBtn" class="btn-primary" style="padding: 10px 20px; font-size: 12px; background: #FF5252; flex: 1;">
                    [ REJECT ]
                </button>
            </div>
        </div>

                <!-- PHASE 6: Mutation Results Panel -->
        <div class="panel" style="background: #1a1a2e; border: 1px solid #0f3460; margin-top: 20px; margin-bottom: 20px;">
            <h3 style="color: #00d4ff; margin-top: 0;">📊 Mutation Results</h3>
            <div id="mutationResultsContent" style="background: #0f1419; padding: 12px; border-radius: 4px; min-height: 120px; font-family: monospace; font-size: 11px; color: #aaa;">
                <div style="color: #666;">Waiting for mutation results...</div>
            </div>
        </div>

        <!-- PHASE 7: Trajectory Panel -->
        <div class="panel" style="background: #1a1a2e; border: 1px solid #0f3460; margin-top: 20px; margin-bottom: 20px;">
            <h3 style="color: #00d4ff; margin-top: 0;">📈 Trajectory</h3>
            <div id="trajectoryContent" style="background: #0f1419; padding: 12px; border-radius: 4px; min-height: 120px; font-family: monospace; font-size: 11px; color: #aaa;">
                <div style="color: #666;">Waiting for trajectory analysis...</div>
            </div>
        </div>

        <!-- PHASE 8: Control Status Panel -->
        <div class="panel" style="background: #1a1a2e; border: 1px solid #0f3460; margin-top: 20px; margin-bottom: 20px;">
            <h3 style="color: #00d4ff; margin-top: 0;">🛡️ Control Status</h3>
            <div id="controlContent" style="background: #0f1419; padding: 12px; border-radius: 4px; min-height: 100px; font-family: monospace; font-size: 11px; color: #aaa;">
                <div style="color: #666;">Evaluating control layer...</div>
            </div>
        </div>

<!-- Recent Trades Table -->
        <div class="trades-section">
            <h2>Recent Trades</h2>
            <div class="trades-table-wrapper">
                <table class="trades-table" id="trades-table">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Asset</th>
                            <th>Signal</th>
                            <th>Source</th>
                            <th>Side</th>
                            <th>Entry</th>
                            <th>Exit</th>
                            <th>PnL</th>
                            <th>Duration</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PHASE 32.2 PART 6: Capital Reset Confirmation Modal -->
    <div id="resetCapitalModal" class="modal hidden">
        <div class="modal-overlay"></div>
        <div class="modal-content">
            <div class="modal-header">
                <h2>Reset Arena Capital</h2>
                <button class="modal-close" id="modalCloseBtn">&times;</button>
            </div>
            <div class="modal-body">
                <p><strong>This will:</strong></p>
                <ul>
                    <li>Reset equity to $10,000</li>
                    <li>Clear P&L metrics</li>
                    <li>Start a new run segment</li>
                </ul>
                <p class="modal-note"><strong>Note:</strong> This does NOT change your active strategy</p>
                <p class="modal-note"><strong>Warning:</strong> This action cannot be undone</p>
                <p style="margin-top: 20px; margin-bottom: 10px;">To confirm, type the current strategy name:</p>
                <div class="modal-input-group">
                    <input type="text" id="strategyNameConfirm" class="modal-input" placeholder="e.g., baby_010 or baseline" autocomplete="off">
                    <span id="confirmationHint" class="confirmation-hint">Strategy name required</span>
                </div>
            </div>
            <div class="modal-footer">
                <button id="modalCancelBtn" class="btn-modal-cancel">Cancel</button>
                <button id="modalConfirmBtn" class="btn-modal-confirm" disabled>Confirm Reset</button>
            </div>
        </div>
    </div>

    <script src="{{ url_for('static', filename='dashboard.js') }}"></script>
</body>
</html>
